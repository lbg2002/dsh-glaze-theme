{
  "name": "dsh-glaze-theme",
  "version": "0.3.1",
  "description": "瓷釉 Glaze for DeepSeek Harness — 16套东方意境莫兰迪配色、艺术字体、思考/输入框/气泡深度 UI 定制与零模糊低消耗主题插件",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/smoke.test.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-theme",
    "deepseek-harness",
    "theme",
    "glaze",
    "morandi",
    "oklch",
    "custom-brand",
    "low-overhead"
  ],
  "license": "MIT",
  "files": [
    "cordis.patch.yml",
    "lib/",
    "src/",
    "scripts/install-local.mjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}
